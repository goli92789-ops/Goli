# Mofid EasyTrader login (same as https://login.emofid.com)
MOFID_USERNAME=
MOFID_PASSWORD=

# Login for the web panel itself (HTTP Basic Auth) -- pick your own values,
# use a long random password since this panel is reachable from the internet.
PANEL_USERNAME=
PANEL_PASSWORD=

# Port the web panel listens on.
PANEL_PORT=3000

# Set to "false" to watch the browser via a remote desktop while debugging.
# Must stay "true" on the VPS (no display available).
HEADLESS=true
