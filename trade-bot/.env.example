# Mofid EasyTrader login (same as https://login.emofid.com)
MOFID_USERNAME=
MOFID_PASSWORD=

# Create a bot with @BotFather on Telegram, paste the token it gives you
TELEGRAM_BOT_TOKEN=

# Only this Telegram chat ID is allowed to control the bot.
# Message @userinfobot on Telegram to find your numeric chat ID.
TELEGRAM_ALLOWED_CHAT_ID=

# Set to "false" to watch the browser via a remote desktop while debugging.
# Must stay "true" on the VPS (no display available).
HEADLESS=true
